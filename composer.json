{
    "name": "mr-dlef/os-query-digest",
    "description": "Human-readable, loggable digests and stable fingerprints for OpenSearch DSL queries.",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "keywords": [
        "opensearch",
        "dsl",
        "dql",
        "logging",
        "fingerprint",
        "observability",
        "debug"
    ],
    "homepage": "https://mrdlef.github.io/php-os-query-digest/",
    "authors": [
        {
            "name": "Denis Favreau",
            "homepage": "https://github.com/mrDlef"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*"
    },
    "bin": [
        "bin/os-query-digest"
    ],
    "suggest": {
        "monolog/monolog": "To replace raw search requests with their digest automatically, via MrDlef\\OsQueryDigest\\Monolog\\DigestProcessor (^2.0 || ^3.0)",
        "psr/http-client": "To digest every search on its way out of any PSR-18 client, via MrDlef\\OsQueryDigest\\Http\\DigestingClient (^1.0)",
        "psr/log": "To log what the transport integrations capture, via MrDlef\\OsQueryDigest\\Http\\LoggingObserver (^1.1 || ^2.0 || ^3.0)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.4",
        "monolog/monolog": "^2.0 || ^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "rector/rector": "^2.6",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "MrDlef\\OsQueryDigest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrDlef\\OsQueryDigest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "rector-check": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
