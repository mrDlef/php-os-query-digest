{
    "index": "orders",
    "request": {
        "query": {
            "bool": {
                "filter": [
                    { "terms": { "status": [ "new", "paid", "shipped", "cancelled", "refunded", "pending", "failed", "draft" ] } },
                    { "term": { "country": "FR" } }
                ]
            }
        }
    }
}
